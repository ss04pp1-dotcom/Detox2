# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# `.dev.vars` is loaded automatically by wrangler dev and is git-ignored.
# NEVER commit real secrets. NEVER put real secrets in wrangler.toml [vars].

# Google OAuth — set the real values via `wrangler secrets put` for deployed envs.
# When left empty AND API_ENV=development, the API accepts dev-mode
# credentials of the form "dev:<email>" for local testing only.
GOOGLE_CLIENT_SECRET=
ADMIN_SESSION_SECRET=dev-only-admin-session-secret-change-me

# Optional — Google Play service account (subscription verification):
# GOOGLE_PLAY_SA_EMAIL=play-api-sa@maxleveldetox.iam.gserviceaccount.com
# GOOGLE_PLAY_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
