<?xml version="1.0" encoding="utf-8"?>
<!-- v2.2 Phase D — shared widget card layout (streak/session/usage/coins).
     Dark theme matches the app design system: bg #0F1629, indigo accent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_streak_title" />

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#F1F5F9"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="—" />

    <TextView
        android:id="@+id/widget_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />
</LinearLayout>
