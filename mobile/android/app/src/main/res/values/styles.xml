<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mld" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0A0E1A</item>
        <item name="android:windowBackground">#0A0E1A</item>
    </style>

    <!-- Lock/alarm screens: immersive, over the lock screen. -->
    <style name="Theme.Mld.Lock" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#0A0E1A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0A0E1A</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
